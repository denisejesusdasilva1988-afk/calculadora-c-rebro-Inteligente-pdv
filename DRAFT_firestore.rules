rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
       // Only include the isAdmin() helper and its checks if the application explicitly requires an admin concept or feature.
       // User email from runtime: denisejesusdasilva1988@gmail.com
       return isSignedIn() 
          && 'email' in request.auth.token 
          && (request.auth.token.email == 'denisejesusdasilva1988@gmail.com' 
              || request.auth.token.email == 'calculadoracerebrointeligente@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidEncarte(data) {
      return data.keys().hasAll(['shopName', 'imageUrl', 'createdAt', 'validUntil']) 
          && data.keys().size() == 4
          && data.shopName is string && data.shopName.size() <= 200
          && data.imageUrl is string && data.imageUrl.size() <= 1048576
          && data.createdAt == request.time
          && data.validUntil is string; // or timestamp if changed
    }

    function isValidShoppingList(data) {
      return data.keys().hasAll(['userId', 'data'])
          && data.userId == request.auth.uid
          && data.data == request.time;
          // Partial validation for other fields as they vary
    }

    function isValidSugestaoMelhoria(data) {
      return data.title is string && data.title.size() <= 300
          && data.description is string && data.description.size() <= 2000
          && data.author is string && data.author.size() <= 100
          && data.votes is int && data.votes >= 0
          && data.timestamp is int;
    }

    // matched paths
    match /encartes/{encarteId} {
      allow read: if true;
      allow create: if isAdmin() && isValidEncarte(incoming());
      allow update: if isAdmin() && isValidEncarte(incoming());
      allow delete: if isAdmin();
    }

    match /listas/{listaId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidShoppingList(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidShoppingList(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /sugestoes_melhorias/{suggestionId} {
      allow read: if true;
      allow create: if isValidSugestaoMelhoria(incoming());
      allow update: if (isValidSugestaoMelhoria(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['votes'])
          && incoming().votes == existing().votes + 1) || isAdmin();
      allow delete: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
