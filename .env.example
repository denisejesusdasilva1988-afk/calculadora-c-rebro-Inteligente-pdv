# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MERCADO_PAGO_ACCESS_TOKEN: Optional global credential for Mercado Pago POS integrations.
# Can also be customized individually on the "Taxas & Maquininhas" tab inside the PDV!
MERCADO_PAGO_ACCESS_TOKEN=""

# MERCADO_PAGO_CLIENT_ID: Client ID for Mercado Pago OAuth Connection
MERCADO_PAGO_CLIENT_ID=""

# MERCADO_PAGO_CLIENT_SECRET: Client Secret for Mercado Pago OAuth Connection
MERCADO_PAGO_CLIENT_SECRET=""

# MERCADO_PAGO_PUBLIC_KEY: Public Key for Mercado Pago integration
MERCADO_PAGO_PUBLIC_KEY=""

# VAPID_PUBLIC_KEY: Public Key for Web Push Notifications (auto-generated if empty)
VAPID_PUBLIC_KEY=""

# VAPID_PRIVATE_KEY: Private Key for Web Push Notifications (auto-generated if empty)
VAPID_PRIVATE_KEY=""


