rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
       return isSignedIn() 
          && 'email' in request.auth.token 
          && (request.auth.token.email == 'denisejesusdasilva1988@gmail.com' 
              || request.auth.token.email == 'denisejesusdasilva1988@gmail.com.br'
              || request.auth.token.email == 'calculadoracerebrointeligente@gmail.com');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEncarte(data) {
      return data.keys().hasAll(['shopName', 'imageUrl', 'createdAt', 'validUntil']) 
          && data.shopName is string && data.shopName.size() <= 200
          && data.imageUrl is string && data.imageUrl.size() <= 1048576;
    }

    function isValidShoppingList(data) {
      return (data.userId == request.auth.uid) || isAdmin();
    }

    function isValidUserData(data) {
      return (data.get('userId', request.auth.uid) == request.auth.uid) || isAdmin();
    }

    function isValidAgendaEvent(data) {
      return ((data.userId == request.auth.uid) || isAdmin())
          && data.title is string && data.title.size() <= 200
          && data.type in ['shopping', 'payment_received', 'payment_made', 'general'];
    }

    function isValidNote(data) {
      return ((data.userId == request.auth.uid) || isAdmin())
          && data.text is string && data.text.size() <= 100000;
    }

    function isValidSugestaoMelhoria(data) {
      return data.title is string && data.title.size() <= 300
          && data.description is string && data.description.size() <= 2000
          && data.author is string && data.author.size() <= 100
          && data.votes is int && data.votes >= 0
          && data.timestamp is int;
    }

    function isValidAuditLog(data) {
      return data.userId == request.auth.uid
          && data.staffName is string && data.staffName.size() <= 200
          && data.staffRole is string && data.staffRole.size() <= 100
          && data.action is string && data.action.size() <= 200
          && data.description is string && data.description.size() <= 1000;
    }

    function isValidSystemSettings(data) {
      return data.userId == request.auth.uid;
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid 
          && data.email is string && data.email.size() <= 200;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRecyclingMomentPhoto(data, ownerUid, photoId) {
      return data.keys().hasAll(['id', 'userId', 'collaboratorId', 'collaboratorName', 'category', 'imageDataUrl', 'capturedAt', 'createdAtMs', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['id', 'userId', 'collaboratorId', 'collaboratorName', 'caption', 'category', 'imageDataUrl', 'capturedAt', 'createdAtMs', 'createdAt', 'updatedAt'])
          && data.id == photoId && isValidId(data.id)
          && data.userId is string && data.userId == ownerUid && (data.userId == request.auth.uid || isAdmin())
          && isValidId(data.collaboratorId)
          && data.collaboratorName is string && data.collaboratorName.size() >= 1 && data.collaboratorName.size() <= 120
          && (!('caption' in data) || (data.caption is string && data.caption.size() <= 240))
          && data.category in ['entrega', 'pesagem', 'coleta', 'pagamento', 'carga', 'outro']
          && data.imageDataUrl is string && data.imageDataUrl.size() >= 20 && data.imageDataUrl.size() <= 450000
          && data.imageDataUrl.matches('^data:image/(jpeg|jpg|png|webp);base64,.*')
          && data.capturedAt is string && data.capturedAt.size() >= 1 && data.capturedAt.size() <= 64
          && data.createdAtMs is int && data.createdAtMs > 0
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    match /encartes/{encarteId} {
      allow read: if true;
      allow write: if isAdmin() && isValidEncarte(incoming());
    }

    match /listas/{listaId} {
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidShoppingList(incoming());
      allow update: if ((isSignedIn() && existing().userId == request.auth.uid) || isAdmin()) && isValidShoppingList(incoming());
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /userData/{userId} {
      allow get: if isSignedIn() && userId == request.auth.uid;
      allow write: if isSignedIn() && userId == request.auth.uid && isValidUserData(incoming());
    }

    match /agenda/{eventId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidAgendaEvent(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidAgendaEvent(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /notas/{notaId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNote(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidNote(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /sugestoes_melhorias/{suggestionId} {
      allow read: if true;
      allow create: if isValidSugestaoMelhoria(incoming());
      allow update: if (isValidSugestaoMelhoria(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['votes'])
          && incoming().votes == existing().votes + 1) || isAdmin();
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /configuracoes_sistema/{settingId} {
      allow read, write: if isSignedIn() && settingId == request.auth.uid;
    }

    match /configuracoes_globais/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn()
        && userId == request.auth.uid
        && isValidUser(incoming())
        && incoming().get('isOwner', false) == false
        && incoming().get('subscriptionTier', 'free') == 'free'
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && userId == request.auth.uid
        && isValidUser(incoming())
        && (!incoming().keys().hasAny(['isOwner']) || incoming().get('isOwner', false) == existing().get('isOwner', false))
        && (!incoming().keys().hasAny(['subscriptionTier']) || incoming().get('subscriptionTier', 'free') == existing().get('subscriptionTier', 'free'))
        && (!incoming().keys().hasAny(['trialStartedAt']) || !existing().keys().hasAny(['trialStartedAt']) || incoming().get('trialStartedAt', '') == existing().get('trialStartedAt', ''))
      );
      allow delete: if isAdmin();

      match /pdv_data/{docId} {
        allow read, write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
      }

      match /recycling_gallery/{photoId} {
        allow get: if isAdmin() || (isSignedIn() && userId == request.auth.uid && isValidId(photoId));
        allow list: if isAdmin() || (isSignedIn() && userId == request.auth.uid && resource.data.userId == request.auth.uid);
        allow create: if (isAdmin() || (isSignedIn() && userId == request.auth.uid))
                      && isValidId(photoId)
                      && isValidRecyclingMomentPhoto(incoming(), userId, photoId)
                      && incoming().createdAt == request.time
                      && incoming().updatedAt == request.time;
        allow update: if (isAdmin() || (isSignedIn() && userId == request.auth.uid))
                      && isValidId(photoId)
                      && isValidRecyclingMomentPhoto(incoming(), userId, photoId)
                      && incoming().userId == existing().userId
                      && incoming().id == existing().id
                      && incoming().imageDataUrl == existing().imageDataUrl
                      && incoming().capturedAt == existing().capturedAt
                      && incoming().createdAt == existing().createdAt
                      && incoming().createdAtMs == existing().createdAtMs
                      && incoming().updatedAt == request.time
                      && incoming().diff(existing()).affectedKeys().hasOnly(['collaboratorId', 'collaboratorName', 'caption', 'category', 'updatedAt']);
        allow delete: if isAdmin() || (isSignedIn() && userId == request.auth.uid && isValidId(photoId));
      }
    }

    match /marketing_ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Portal Público da Agenda de Clientes & Perfil Público da Empresa
    match /agendas_publicas/{agendaId} {
      allow read: if true;
      allow write: if true;

      match /agendamentos/{agId} {
        allow read, write: if true;
      }
      match /encomendas/{encId} {
        allow read, write: if true;
      }
    }

    match /company_profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    match /cpf_directory/{cpfDigits} {
      allow read, write: if true;
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
